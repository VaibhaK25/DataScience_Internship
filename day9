
import matplotlib.pyplot as plt
names = ['vibes', 'vish', 'xyz']
marks = [60, 30, 10]
plt.figure(figsize=(15, 4))
plt.subplot(1, 3, 1)
plt.pie(marks, labels=names, autopct='%1.0f%%')
plt.title('Share of Marks')
plt.subplot(1, 3, 2)
plt.bar(names, marks)
plt.title('Marks Comparison')
plt.ylabel('Marks')
plt.subplot(1, 3, 3)
plt.plot(names, marks, marker='o')
plt.title('Performance Trend')
plt.ylabel('Marks')
plt.tight_layout()
plt.show()
