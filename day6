
import pandas as pd
data = {
    'Name': ['Alice', 'Bob', 'Charlie', 'David'],
    'Age': [25, 32, 45, 19],
    'City': ['New York', 'London', 'Paris', 'London'],
    'Score': [85, 90, 78, 92]
}
df = pd.DataFrame(data)
filtered_df = df.loc[
    (df['Age'] > 20) & (df['City'] == 'London'), 
    ['Name', 'City', 'Score']
]
print("Original Dataset:\n", df, "\n")
print("Filtered Dataset:\n", filtered_df)
